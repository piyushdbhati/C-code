#include <stdio.h>

struct Student {
    int roll_no;
    char name[50];
    float marks;
};

int main() 
{
    int  i;

    struct Student s;

    for(i = 0; i < 4; i++) {
        printf("Enter details for Student %d:\n", i + 1);
        printf("Roll Number: ");
        scanf("%d", &s[i].roll_no);
        printf("Name: ");
        scanf("%s", s[i].name);
        printf("Marks: ");
        scanf("%f", &s[i].marks);
    }
    for(i = 0; i < 4; i++) {
        printf("Student %d | Roll No: %d | Name: %s | Marks: %f\n", 
                i + 1, s[i].roll_no, s[i].name, s[i].marks);
    }

    return 0;
}
