#include <stdio.h>

struct Student {
    int roll_no;
    char name[50];
    float marks;
};

int main() 
{
    int n, i;

    printf("Enter the number of students: ");
    scanf("%d", &n);

    struct Student s;

    for(i = 0; i < n; i++) {
        printf("\nEnter details for Student %d:\n", i + 1);
        printf("Roll Number: ");
        scanf("%d", &s[i].roll_no);
        printf("Name: ");
        scanf("%s", s[i].name);
        printf("Marks: ");
        scanf("%f", &s[i].marks);
    }
    for(i = 0; i < n; i++) {
        printf("Student %d | Roll No: %d | Name: %s | Marks: %.2f\n", 
                i + 1, s[i].roll_no, s[i].name, s[i].marks);
    }

    return 0;
}
