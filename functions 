#include <stdio.h>

void add();
void sub();
void mul();
void div();

int main() {
    int choice;

    while(1) {
        
        printf("1. Add\n2. Subtract\n3. Multiply\n4. Divide\n);
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch(choice) {
            case 1: add(); break;
            case 2: sub(); break;
            case 3: mul(); break;
            case 4: div(); break;
            default: printf("Invalid choice!\n");
        }
    }
    return 0;
}

void add() {
    float a, b;
    printf("Enter two numbers: ");
    scanf("%f %f", &a, &b);
    printf("Result: %f", a + b);
}

void sub() {
    float a, b;
    printf("Enter two numbers: ");
    scanf("%f %f", &a, &b);
    printf("Result: %f", a - b);
}

void mul() {
    float a, b;
    printf("Enter two numbers: ");
    scanf("%f %f", &a, &b);
    printf("Result: %f", a * b);
}

void div() {
    float a, b;
    printf("Enter two numbers: ");
    scanf("%f %f", &a, &b);
    if(b != 0) 
        printf("Result: %f", a / b);
    else 
        printf("Error");
}
